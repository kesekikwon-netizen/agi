{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PROJECT_DIR/.claude/hooks/commit-gate.mjs\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
